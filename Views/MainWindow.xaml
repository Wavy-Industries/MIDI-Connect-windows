<Window x:Class="MIDIConnect.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MIDIConnect.Converters"
        Title="MIDI Connect"
        Width="220"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="True"
        Topmost="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <Style x:Key="DeviceListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MaxHeight" Value="120"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBox">
                                <TextBlock Text="No devices"
                                           Foreground="#888888"
                                           FontStyle="Italic"
                                           Margin="12,8"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeviceListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3c3c3c"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0078d4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#aaaaaa"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="HeaderText">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="12,10,12,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="DeviceText">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="EmptyText">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="12,8"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </Window.Resources>
    <Border Background="#252526" CornerRadius="6" BorderBrush="#3c3c3c" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="CONNECTED"
                       Grid.Row="0"
                       Style="{StaticResource HeaderText}"/>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ConnectedDevices}"
                     SelectedItem="{Binding SelectedConnectedDevice, Mode=TwoWay}"
                     Style="{StaticResource DeviceListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       Style="{StaticResource DeviceText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="&#x25BC;"
                                       Foreground="#4ec9b0"
                                       FontSize="9"
                                       Margin="6,0,2,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IncomingTraffic, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Column="2"
                                       Text="&#x25B2;"
                                       Foreground="#ce9178"
                                       FontSize="9"
                                       Margin="2,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding OutgoingTraffic, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DeviceListBoxItem}">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TextBlock Text="AVAILABLE"
                       Grid.Row="2"
                       Style="{StaticResource HeaderText}"/>

            <ListBox Grid.Row="3"
                     ItemsSource="{Binding DiscoveredDevices}"
                     SelectedItem="{Binding SelectedDiscoveredDevice, Mode=TwoWay}"
                     Style="{StaticResource DeviceListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource DeviceText}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource DeviceListBoxItem}">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Border Grid.Row="4"
                    BorderBrush="#3c3c3c"
                    BorderThickness="0,1,0,0"
                    Margin="0,8,0,0"
                    Padding="12,8">
                <Grid>
                    <TextBlock x:Name="CopyrightText"
                               Foreground="#666666"
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <Button Content="Exit"
                            Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding ExitCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
