<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  MIDI Connect WiX Installer
  Copyright (c) 2024 Wavy Industries AS
  
  NOTE: The Inno Setup installer (MIDI_Connect_Setup.iss) is recommended.
  This WiX file is provided as an alternative for MSI-based deployment.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
     
  <Product Id="*" 
           Name="MIDI Connect" 
           Language="1033" 
           Version="1.0.0.0" 
           Manufacturer="Wavy Industries AS" 
           UpgradeCode="MIDI-CONN-WAVY-IND-2024-UPGRADE">
    
    <Package InstallerVersion="500" 
             Compressed="yes" 
             InstallScope="perMachine"
             Description="MIDI Connect - Bluetooth MIDI Device Manager"
             Manufacturer="Wavy Industries AS" />
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of MIDI Connect is already installed." />
    
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    
    <!-- Icon for Add/Remove Programs -->
    <Icon Id="AppIcon.ico" SourceFile="..\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://wavyindustries.com" />
    <Property Id="ARPCONTACT" Value="hello@wavyindustries.com" />
    
    <!-- Properties for loopMIDI detection -->
    <Property Id="LOOPMIDI_INSTALLED">
      <RegistrySearch Id="LoopMidiRegistry"
                      Root="HKLM"
                      Key="SOFTWARE\Tobias Erichsen\loopMIDI"
                      Name="Version"
                      Type="raw" />
    </Property>
    
    <!-- Launch condition for loopMIDI -->
    <Condition Message="MIDI Connect requires loopMIDI to be installed. Please install loopMIDI from https://www.tobias-erichsen.de/software/loopmidi.html before continuing.">
      <![CDATA[LOOPMIDI_INSTALLED OR Installed]]>
    </Condition>
    
    <!-- Directory Structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="WavyIndustriesFolder" Name="Wavy Industries">
          <Directory Id="INSTALLFOLDER" Name="MIDI Connect">
          </Directory>
        </Directory>
      </Directory>
      
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="MIDI Connect" />
      </Directory>
      
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
    
    <!-- Main Application Components -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      
      <Component Id="MainExecutable" Guid="MIDI-CONN-EXE-GUID-0001" Win64="yes">
        <File Id="MIDIConnect.exe" 
              Source="..\bin\Release\net10.0-windows10.0.22621.0\publish\MIDIConnect.exe" 
              KeyPath="yes" />
      </Component>
      
      <Component Id="MainDll" Guid="MIDI-CONN-DLL-GUID-0002" Win64="yes">
        <File Id="MIDIConnect.dll" 
              Source="..\bin\Release\net10.0-windows10.0.22621.0\publish\MIDIConnect.dll" />
      </Component>
      
      <Component Id="RuntimeConfig" Guid="MIDI-CONN-CFG-GUID-0003" Win64="yes">
        <File Id="MIDIConnect.runtimeconfig.json" 
              Source="..\bin\Release\net10.0-windows10.0.22621.0\publish\MIDIConnect.runtimeconfig.json" />
      </Component>
      
      <Component Id="AppIcon" Guid="MIDI-CONN-ICO-GUID-0004" Win64="yes">
        <File Id="icon.ico" Source="..\icon.ico" />
      </Component>
      
      <Component Id="RegistryEntries" Guid="MIDI-CONN-REG-GUID-0005" Win64="yes">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Wavy Industries\MIDI Connect">
          <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Name="Version" Type="string" Value="1.0.0.0" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
    
    <!-- Start Menu Shortcuts -->
    <ComponentGroup Id="StartMenuShortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="MIDI-CONN-SMC-GUID-0006" Win64="yes">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="MIDI Connect"
                  Description="Bluetooth MIDI Device Manager"
                  Target="[INSTALLFOLDER]MIDIConnect.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Wavy Industries\MIDI Connect" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    
    <!-- Feature Definition -->
    <Feature Id="ProductFeature" Title="MIDI Connect" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="StartMenuShortcuts" />
    </Feature>
    
  </Product>
</Wix>
